# ==========================================================
# AIVOA.AI RCA Module - Git Ignore Configuration
# ==========================================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# Environment & Secrets (NEVER commit secrets or API keys)
.env
.env.*
!.env.example
*.pem
*.key

# Python Virtual Environments & Packages
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js & Frontend Build Outputs
node_modules/
dist/
dist-ssr/
build/
*.tsbuildinfo
.npm
.eslintcache

# Logs & Databases
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.sqlite
*.sqlite3

# IDE & Editor Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
